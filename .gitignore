# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Maven build output
target/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Node tooling for Probity TDD guard (dev-only; @nizos/probity is a local devDependency).
# package.json and probity.config.mjs are tracked (reproducible setup + TDD policy).
node_modules/
package-lock.json

# Probity-generated reference data (regenerated by the hook; not hand-authored config).
.claude/tdd-guard/

# Personal Claude Code settings — .claude/settings.json is the shared/tracked config.
.claude/settings.local.json
